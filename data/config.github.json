{
  "version": "1.0",
  "ai": {
    "provider": "gemini",
    "model": "gemini-1.5-flash",
    "api_key_env": "GOOGLE_API_KEY",
    "temperature": 0.2,
    "max_tokens": 2048,
    "throttle_sec": 8,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
